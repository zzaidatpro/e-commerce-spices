{
  "name": "my-ecommerce-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:int": "pnpm --filter admin exec vitest run tests/integration",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:int && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.65.1",
    "dotenv": "^18.0.10",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "3.1.0",
    "turbo": "latest",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@12.8.1"
}