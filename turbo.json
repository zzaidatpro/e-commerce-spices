{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY", "NEXT_PUBLIC_AUTH_COOKIE_NAME", "NEXT_PUBLIC_WEB_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY", "NEXT_PUBLIC_AUTH_COOKIE_NAME", "NEXT_PUBLIC_WEB_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {},
    "lint": {},
    "test:unit": {
      "outputs": ["coverage/**"]
    }
  }
}